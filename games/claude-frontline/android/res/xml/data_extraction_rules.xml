<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 及以上：云备份和换机迁移都不带 AI 助手的 API Key -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_keys.xml" />
    </device-transfer>
</data-extraction-rules>
